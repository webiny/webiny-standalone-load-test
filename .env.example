# Copy to .env and fill with random values (openssl rand -hex 24). Never commit .env.
WEBINY_ENCRYPTION_PASSPHRASE=
WEBINY_ENCRYPTION_SALT=
WEBINY_HASHING_PEPPER=
WEBINY_UPLOAD_SECRET=
WEBINY_SELF_HOSTED_AUTH_SECRET=

# Folder under builds/ with the API and Admin builds under test, e.g. 6f462b597f-postgres-unlicensed.
WEBINY_BUILD=

# Bearer token for the API, created in the Admin (Settings > Access Management > API Keys).
API_KEY=

# Admin user for websocket tests (they log in; an API key is not enough).
ADMIN_EMAIL=
ADMIN_PASSWORD=
